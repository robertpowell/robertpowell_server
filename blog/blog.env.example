# Copy to /opt/ropo-blog/blog.env (mode 600, owner ropoblog) and fill in. Read by ropo-blog.service.
BLOG_DB=/opt/ropo-blog/data/blog.db
BLOG_SECRET_KEY=            # long random string; python3 -c 'import secrets;print(secrets.token_hex(32))'
BLOG_ADMIN_HASH=            # werkzeug password hash for the admin login
BLOG_SITE_NAME=robertpowell.com
BLOG_TAGLINE=
BLOG_SITE_URL=https://new.robertpowell.com
