[Unit]
Description=GeoIP nftables country filter (loads the last-good /etc/nftables.d/geoip-allow.nft)
After=network-pre.target ufw.service
Before=fail2ban.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/geoip-allow.nft
ExecStop=/usr/sbin/nft delete table inet geoip-filter

[Install]
WantedBy=multi-user.target
